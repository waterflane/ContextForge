{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextforge.dev/schemas/retrieval-result-v3.schema.json",
  "title": "ContextForge Retrieval Result v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_snapshot_digest", "generation_id", "task", "candidates", "reranked", "provider_calls", "diagnostics", "evidence_plan", "planning_diagnostics"],
  "properties": {
    "schema_version": { "const": 3 },
    "source_snapshot_digest": { "$ref": "#/$defs/sha256" },
    "generation_id": { "$ref": "#/$defs/sha256" },
    "task": { "type": "string", "minLength": 1 },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "reranked": { "type": "boolean" },
    "provider_calls": { "type": "integer", "minimum": 0 },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "evidence_plan": { "oneOf": [{ "$ref": "#/$defs/evidence_plan" }, { "type": "null" }] },
    "planning_diagnostics": { "oneOf": [{ "$ref": "#/$defs/planning_diagnostics" }, { "type": "null" }] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 0 }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "summary", "slice", "full"],
      "properties": {
        "map": { "type": "integer", "minimum": 0 },
        "summary": { "type": ["integer", "null"], "minimum": 0 },
        "slice": { "type": ["integer", "null"], "minimum": 0 },
        "full": { "type": "integer", "minimum": 0 }
      }
    },
    "planning_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "provider_calls", "input_tokens", "output_tokens", "rounds", "dropped_candidates", "dropped_evidence_ids", "messages"],
      "properties": {
        "mode": { "enum": ["off", "auto", "required"] },
        "status": { "enum": ["planned", "fallback", "failed"] },
        "provider_calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "rounds": { "type": "integer", "minimum": 0 },
        "dropped_candidates": { "type": "integer", "minimum": 0 },
        "dropped_evidence_ids": { "type": "integer", "minimum": 0 },
        "messages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "planned_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "path", "source_sha256", "evidence_ids", "representation"],
      "properties": {
        "candidate_id": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_ids": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "representation": { "enum": ["map", "summary", "slice", "full"] }
      }
    },
    "evidence_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_snapshot_digest", "items", "sufficiency", "interpretation", "diagnostics"],
      "properties": {
        "schema_version": { "const": 1 },
        "source_snapshot_digest": { "$ref": "#/$defs/sha256" },
        "items": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/planned_evidence" } },
        "sufficiency": { "enum": ["sufficient", "insufficient"] },
        "interpretation": { "type": ["string", "null"], "maxLength": 2000 },
        "diagnostics": { "$ref": "#/$defs/planning_diagnostics" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "path", "source_sha256", "synopsis", "exact_group", "score", "bm25_score", "matched_concepts", "matched_symbols", "evidence_ranges", "graph_neighbors", "provenance", "freshness", "estimated_cost", "suggested_representation"],
      "properties": {
        "candidate_id": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "synopsis": { "type": "string" },
        "exact_group": { "enum": ["exact_path", "exact_qualified_symbol", "exact_symbol", "exact_source_identifier", "approximate"] },
        "score": { "type": "number", "minimum": 0 },
        "bm25_score": { "type": "number", "minimum": 0 },
        "matched_concepts": { "type": "array", "items": { "type": "string" } },
        "matched_symbols": { "type": "array", "items": { "type": "string" } },
        "evidence_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "source_range", "evidence_id", "strength"],
            "properties": {
              "path": { "type": "string" },
              "source_range": { "$ref": "#/$defs/range" },
              "evidence_id": { "type": ["string", "null"] },
              "strength": { "enum": ["verified", "grounded"] }
            }
          }
        },
        "graph_neighbors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "distance", "relationship_kinds", "provenance"],
            "properties": {
              "path": { "type": "string" },
              "distance": { "enum": [1, 2] },
              "relationship_kinds": { "type": "array", "items": { "type": "string" } },
              "provenance": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "provenance": {
          "description": "Validated ranking signals, including current-diff and working-set when applicable.",
          "type": "array",
          "items": { "type": "string" }
        },
        "freshness": { "const": "current" },
        "estimated_cost": { "$ref": "#/$defs/costs" },
        "suggested_representation": { "enum": ["map", "summary", "slice", "full", null] }
      }
    }
  }
}
