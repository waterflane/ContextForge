{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextforge.dev/schemas/semantic-card-v3.schema.json",
  "title": "ContextForge Semantic Card v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "path", "source_sha256", "facts_sha256", "profile", "provenance", "synopsis", "concepts", "responsibilities", "key_symbols", "side_effects", "profile_facts", "inferred_relationships", "evidence", "quality", "diagnostics"],
  "properties": {
    "schema_version": { "const": 3 },
    "record_kind": { "const": "semantic_card" },
    "path": { "$ref": "#/$defs/path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "facts_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "enum": ["code", "documentation", "config", "test"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "synopsis": { "$ref": "#/$defs/claim" },
    "concepts": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/claim" } },
    "responsibilities": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/claim" } },
    "key_symbols": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/keySymbol" } },
    "side_effects": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/claim" } },
    "profile_facts": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/claim" } } },
    "inferred_relationships": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/inferredRelationship" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "quality": { "enum": ["complete", "partial", "deterministic"] },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/|.*\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 0 }
      }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzer_id", "analyzer_version", "analysis_prompt_version", "response_schema_version", "model_identity"],
      "properties": {
        "analyzer_id": { "type": "string" },
        "analyzer_version": { "type": "string" },
        "analysis_prompt_version": { "type": "string" },
        "response_schema_version": { "type": "integer", "minimum": 1 },
        "model_identity": { "type": ["object", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzer", "method", "cache_hit", "repair_attempted"],
      "properties": {
        "analyzer": { "$ref": "#/$defs/analyzer" },
        "method": { "enum": ["model", "deterministic-fallback", "deterministic-policy"] },
        "cache_hit": { "type": "boolean" },
        "repair_attempted": { "type": "boolean" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "path", "source_sha256", "source_range", "fact_id", "symbol_id"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "path": { "$ref": "#/$defs/path" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_range": { "oneOf": [{ "$ref": "#/$defs/sourceRange" }, { "type": "null" }] },
        "fact_id": { "type": ["string", "null"] },
        "symbol_id": { "type": ["string", "null"] }
      }
    },
    "keySymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_id", "name", "qualified_name", "kind", "evidence_ids", "summary"],
      "properties": {
        "symbol_id": { "type": "string" },
        "name": { "type": "string" },
        "qualified_name": { "type": "string" },
        "kind": { "type": "string" },
        "evidence_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "summary": { "type": ["string", "null"] }
      }
    },
    "inferredRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_candidate_id", "target_path", "target_source_sha256", "target_symbol_id", "target_symbol_name", "evidence_ids"],
      "properties": {
        "target_candidate_id": { "type": "string" },
        "target_path": { "$ref": "#/$defs/path" },
        "target_source_sha256": { "$ref": "#/$defs/sha256" },
        "target_symbol_id": { "type": ["string", "null"] },
        "target_symbol_name": { "type": ["string", "null"] },
        "evidence_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "dropped_items"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dropped_items": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
