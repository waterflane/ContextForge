{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextforge.dev/schemas/contextforge-bridge-v1.schema.json",
  "title": "ContextForge Persistent Bridge Protocol v1",
  "description": "JSON-RPC 2.0 frames transported as UTF-8 NDJSON.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        { "type": "integer" }
      ]
    },
    "method": {
      "enum": [
        "hello",
        "status",
        "snapshot",
        "discover",
        "expand",
        "read",
        "package",
        "$/cancelRequest",
        "shutdown"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "$ref": "#/$defs/method" },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "$/cancelRequest" } },
            "required": ["method"]
          },
          "then": {},
          "else": { "required": ["id"] }
        }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": { "type": "object" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "data"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "data": {
              "type": "object",
              "required": ["code"],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
