{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextforge.dev/schemas/real-repository-benchmark-v2.schema.json",
  "title": "ContextForge real-repository benchmark report v2",
  "description": "Passing results require a verified pipeline and paired final answers; headline savings use final-answer input tokens only for quality-passing runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_name", "verified_pipeline", "runs", "aggregates", "passed"],
  "properties": {
    "schema_version": {"const": 2},
    "suite_name": {"type": "string", "minLength": 1},
    "verified_pipeline": {"type": "boolean"},
    "provider_endpoint": {"type": ["string", "null"]},
    "model_id": {"type": ["string", "null"]},
    "requested_context_window": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_effort": {"type": ["string", "null"]},
    "passed": {"type": "boolean"},
    "builds": {"type": "array", "items": {"$ref": "#/$defs/build"}},
    "runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/run"}
    },
    "aggregates": {
      "type": "array",
      "items": {"$ref": "#/$defs/aggregate"}
    }
  },
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "repetition", "status"],
      "properties": {
        "repository_id": {"type": "string"},
        "repetition": {"type": "integer", "minimum": 1},
        "status": {"enum": ["complete", "skipped", "partial"]},
        "reason": {"type": ["string", "null"]},
        "failed_paths": {"type": "array", "items": {"type": "string"}},
        "failure_code_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "cold_structural_ms": {"type": ["integer", "null"], "minimum": 0},
        "semantic_offline_ms": {"type": ["integer", "null"], "minimum": 0},
        "semantic_provider_calls": {"type": ["integer", "null"], "minimum": 0},
        "semantic_estimated_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "semantic_reported_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "semantic_reported_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "requested_functions": {"type": ["integer", "null"], "minimum": 0},
        "described_functions": {"type": ["integer", "null"], "minimum": 0},
        "file_only_functions": {"type": ["integer", "null"], "minimum": 0},
        "noop_update_ms": {"type": ["integer", "null"], "minimum": 0},
        "noop_provider_calls": {"type": ["integer", "null"], "minimum": 0},
        "noop_generation_unchanged": {"type": ["boolean", "null"]},
        "active_amplification": {"type": ["number", "null"], "minimum": 0},
        "maximum_shard_bytes": {"type": ["integer", "null"], "minimum": 0},
        "fresh_process_reload_successes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "repository_id", "mode", "status", "quality_gate_failed"],
      "properties": {
        "task_id": {"type": "string"}, "repository_id": {"type": "string"},
        "mode": {"enum": ["deterministic", "planned"]},
        "repetition": {"type": "integer", "minimum": 1},
        "status": {"enum": ["complete", "skipped"]}, "skip_reason": {"type": ["string", "null"]},
        "required_file_recall_at_5": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "precision_at_5": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "precision_at_r": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "materialized_required_file_recall": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "range_recall": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "capsule_tokens": {"type": "integer", "minimum": 0}, "ordinary_tokens": {"type": "integer", "minimum": 0},
        "token_savings": {"type": "number"}, "valid_token_savings": {"type": "number"},
        "planner_calls": {"type": "integer", "minimum": 0}, "planner_input_tokens": {"type": "integer", "minimum": 0}, "planner_output_tokens": {"type": "integer", "minimum": 0},
        "planner_status": {"type": ["string", "null"]}, "planner_messages": {"type": "array", "items": {"type": "string"}},
        "latency_ms": {"type": "integer", "minimum": 0}, "plan_sufficient": {"type": ["boolean", "null"]},
        "paired_answer": {"anyOf": [{"$ref": "#/$defs/paired_answer"}, {"type": "null"}]},
        "cold_structural_ms": {"type": ["integer", "null"], "minimum": 0},
        "semantic_offline_ms": {"type": ["integer", "null"], "minimum": 0},
        "deterministic_warm_query_ms": {"type": ["integer", "null"], "minimum": 0},
        "agentic_planner_ms": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_ms": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_provider_calls": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_estimated_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_reported_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "phase_errors": {"type": "array", "items": {"type": "string"}},
        "semantic_provider_calls": {"type": ["integer", "null"], "minimum": 0},
        "semantic_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "semantic_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "semantic_requested_functions": {"type": ["integer", "null"], "minimum": 0},
        "semantic_described_functions": {"type": ["integer", "null"], "minimum": 0},
        "semantic_file_only_functions": {"type": ["integer", "null"], "minimum": 0},
        "citation_validity": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "assertion_recall": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "assertion_evidence_support": {"description": "Assertions with a citation and material evidence IDs, distinct from containment.", "anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "lexical_identifier_support": {"description": "Assertions with lexical or identifier support in cited material, distinct from semantic grounding.", "anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "groundedness_majority": {"type": ["boolean", "null"]}, "quality_not_lower_than_oracle": {"type": ["boolean", "null"]},
        "quality_gate_failed": {"type": "boolean"}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "task_count", "completed_task_count", "skipped_task_count", "quality_gate_failed_count", "headline_token_savings"],
      "properties": {
        "mode": {"enum": ["deterministic", "planned"]}, "task_count": {"type": "integer", "minimum": 0},
        "completed_task_count": {"type": "integer", "minimum": 0}, "skipped_task_count": {"type": "integer", "minimum": 0},
        "required_file_recall_at_5": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "precision_at_5": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "precision_at_r": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "materialized_required_file_recall": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "range_recall": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "capsule_tokens": {"type": "integer", "minimum": 0}, "ordinary_tokens": {"type": "integer", "minimum": 0},
        "planner_calls": {"type": "integer", "minimum": 0}, "planner_input_tokens": {"type": "integer", "minimum": 0}, "planner_output_tokens": {"type": "integer", "minimum": 0},
        "mean_latency_ms": {"type": ["number", "null"], "minimum": 0}, "plan_sufficient_count": {"type": "integer", "minimum": 0}, "planned_task_count": {"type": "integer", "minimum": 0},
        "mean_cold_structural_ms": {"type": ["number", "null"], "minimum": 0},
        "mean_semantic_offline_ms": {"type": ["number", "null"], "minimum": 0},
        "mean_deterministic_warm_query_ms": {"type": ["number", "null"], "minimum": 0},
        "mean_agentic_planner_ms": {"type": ["number", "null"], "minimum": 0},
        "mean_final_answer_ms": {"type": ["number", "null"], "minimum": 0},
        "semantic_provider_calls": {"type": ["integer", "null"], "minimum": 0},
        "semantic_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "semantic_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "final_answer_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "semantic_function_coverage": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "semantic_file_only_rate": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "citation_containment": {"description": "Citation range is contained in supplied material; this is not semantic support.", "anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "assertion_recall": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "assertion_evidence_support": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "lexical_identifier_support": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "groundedness_majority_rate": {"anyOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]},
        "quality_gate_failed_count": {"type": "integer", "minimum": 0}, "headline_token_savings": {"type": "number"}
      }
    },
    "paired_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinary", "oracle", "contextforge", "contextforge_groundedness", "input_token_reduction", "quality_not_lower"],
      "properties": {
        "ordinary": {"anyOf": [{"$ref": "#/$defs/answer"}, {"type": "null"}]},
        "oracle": {"$ref": "#/$defs/answer"},
        "contextforge": {"$ref": "#/$defs/answer"},
        "contextforge_groundedness": {"anyOf": [{"$ref": "#/$defs/judge"}, {"type": "null"}]},
        "input_token_reduction": {"type": "number"},
        "quality_not_lower": {"type": "boolean"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "path", "start_line", "end_line", "material_evidence_ids"],
      "properties": {
        "assertion_id": {"type": "string"},
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "material_evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "assertion_ids", "citations", "assertion_recall", "citation_validity", "assertion_evidence_support", "lexical_identifier_support", "input_tokens"],
      "properties": {
        "answer": {"type": "string"},
        "assertion_ids": {"type": "array", "items": {"type": "string"}},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "valid_citation_count": {"type": "integer", "minimum": 0},
        "invalid_citation_count": {"type": "integer", "minimum": 0},
        "assertion_recall": {"$ref": "#/$defs/rate"},
        "citation_validity": {"$ref": "#/$defs/rate"},
        "assertion_evidence_support": {"$ref": "#/$defs/rate"},
        "lexical_identifier_support": {"$ref": "#/$defs/rate"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "estimated_input_tokens": {"type": "integer", "minimum": 0},
        "provider_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "provider_http_calls": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["votes", "passed", "unsupported_claims", "input_tokens", "provider_http_calls", "duration_ms"],
      "properties": {
        "votes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "boolean"}},
        "passed": {"type": "boolean"},
        "unsupported_claims": {"type": "array", "items": {"type": "string"}},
        "input_tokens": {"type": "integer", "minimum": 0},
        "estimated_input_tokens": {"type": "integer", "minimum": 0},
        "provider_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "provider_http_calls": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
